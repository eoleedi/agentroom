# demo = deterministic offline scenario; live = GMI Cloud for all three agents
AGENTROOM_MODE=demo
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=Qwen/Qwen3.8-27B
GMI_TIMEOUT_SECONDS=45

# Optional. Defaults to the repository's .data directory and the Vite dev origin.
# AGENTROOM_DB=.data/agentroom.sqlite3
APP_ORIGIN=http://localhost:5173
